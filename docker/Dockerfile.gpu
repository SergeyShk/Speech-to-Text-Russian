# syntax=docker/dockerfile:1
# Образ stt-ru для NVIDIA GPU: docker build -f docker/Dockerfile.gpu -t stt-ru:gpu .
# Нужны драйвер NVIDIA 580 или новее и NVIDIA Container Toolkit на хосте

FROM ubuntu:24.04 AS build
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3.12 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.12.12 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON=/usr/bin/python3.12 \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv
WORKDIR /src
COPY pyproject.toml uv.lock README.md LICENSE.txt ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-default-groups --no-install-project --extra service --extra ffmpeg
COPY src src
# onnxruntime-gpu той же версии, что onnxruntime из uv.lock; оба ставят модуль onnxruntime
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-default-groups --no-editable --extra service --extra ffmpeg \
    && version="$(/opt/venv/bin/python -c "import importlib.metadata as m; print(m.version('onnxruntime'))")" \
    && uv pip uninstall --python /opt/venv/bin/python onnxruntime \
    && uv pip install --python /opt/venv/bin/python "onnxruntime-gpu==$version"

# onnxruntime-gpu 1.31 собран под CUDA 13 и cuDNN 9
FROM nvidia/cuda:13.0.3-cudnn-runtime-ubuntu24.04
ARG MODEL=gigaam-v3-e2e-rnnt
ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/opt/huggingface
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3.12 \
    && rm -rf /var/lib/apt/lists/* \
    && if id ubuntu >/dev/null 2>&1; then userdel --remove ubuntu; fi \
    && useradd --uid 1000 --create-home stt \
    && mkdir -p /opt/huggingface /data \
    && chown stt:stt /opt/huggingface /data
COPY --from=build /opt/venv /opt/venv
RUN python -c "import onnxruntime as ort; assert 'CUDAExecutionProvider' in ort.get_available_providers()"
USER stt
# Модель загружается на CPU: при сборке GPU нет
RUN if [ -n "$MODEL" ]; then \
        python -c "import sys; from stt_ru import Transcriber; Transcriber(sys.argv[1], providers=['CPUExecutionProvider'])" "$MODEL"; \
    fi
WORKDIR /data
EXPOSE 8000
STOPSIGNAL SIGINT
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --start-interval=2s \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=4)"]
ENTRYPOINT ["stt-ru"]
CMD ["serve", "--host", "0.0.0.0"]
